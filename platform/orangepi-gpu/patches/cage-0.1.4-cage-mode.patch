--- a/output.c
+++ b/output.c
@@ -41,6 +41,23 @@
 #include "xwayland.h"
 #endif
 
+
+#include <stdio.h>
+#include <stdlib.h>
+static struct wlr_output_mode *cage_pick_mode(struct wlr_output *o) {
+	const char *want = getenv("CAGE_MODE");
+	int w = 0, h = 0;
+	if (want && sscanf(want, "%dx%d", &w, &h) == 2) {
+		struct wlr_output_mode *m, *best = NULL;
+		wl_list_for_each(m, &o->modes, link) {
+			if (m->width == w && m->height == h && (!best || m->refresh > best->refresh))
+				best = m;
+		}
+		if (best) return best;
+	}
+	return cage_pick_mode(o);
+}
+
